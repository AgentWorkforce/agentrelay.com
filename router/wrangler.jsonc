{
  "$schema": "../web/node_modules/wrangler/config-schema.json",
  "name": "agentrelay-router",
  "main": "index.ts",
  "compatibility_date": "2025-04-01",
  "compatibility_flags": ["nodejs_compat"],

  // The router fronts agentrelay.com. It binds resources that remain OWNED BY THE
  // CLOUD SST APP in the same Cloudflare account — referenced here by stable
  // name/id. These identifiers are cloud-owned; if cloud ever recreates the
  // resource the value here must be updated (see the repo's Phase 2 notes).

  // /cloud* → the cloud Next.js Worker, by stable prod script name.
  // (Webhook offload uses the WEBHOOK_WORKER_ORIGIN URL below, not a service
  // binding — SST names the webhook Worker with a random hash suffix, so it
  // isn't bindable by a stable script name.)
  "services": [
    { "binding": "CLOUD_WEB_WORKER", "service": "cloud-web-worker" },
    { "binding": "RELAY_AGENT_WORKER", "service": "relay-agent" }
  ],

  // The relay-agent Worker MUST be deployed before this router configuration.
  // The binding routes valid agent-chat POSTs directly to it. If a binding is
  // unavailable in another environment, RELAY_AGENT_ORIGIN is the alternative.
  // Remove both to roll back to the existing Cloud path.

  // ROUTER_CONFIG: holds the WEBHOOK_ORIGIN ops flag + recorder config.
  // Look up the prod id: `wrangler kv namespace list` (title router-config).
  "kv_namespaces": [
    { "binding": "ROUTER_CONFIG", "id": "e73a3fc0c2514460bdd3afae463e5234" }
  ],

  // Replay/traffic recorder corpus (14-day lifecycle, owned by cloud).
  "r2_buckets": [
    { "binding": "TRAFFIC_RECORDER", "bucket_name": "traffic-recorder" }
  ],

  // Server-side arelay.to analytics (relay-agent docs/ANALYTICS_BRIEF.md). Same
  // dataset relay-agent writes. agent_guide_fetched also needs the
  // ANALYTICS_VISITOR_HASH_SECRET Worker secret; without it nothing is written.
  "analytics_engine_datasets": [
    { "binding": "ARELAY_ANALYTICS", "dataset": "arelay_agent_analytics" }
  ],

  "vars": {
    "CLOUD_APP_ORIGIN": "https://origin.agentrelay.cloud",
    "FILE_OBSERVER_ORIGIN": "https://relayfile-file-observer.pages.dev",
    // The dedicated webhook Worker the router forwards /api/v1/webhooks/* to when
    // the ROUTER_CONFIG `WEBHOOK_ORIGIN` flag is "worker" (it is, in prod). This
    // is cloud-owned and the script name carries a random hash suffix, so it
    // would change if cloud recreates that Worker — re-copy it from the live
    // router's WEBHOOK_WORKER_ORIGIN if webhook routing ever 5xxs.
    "WEBHOOK_WORKER_ORIGIN": "https://incoming-webhooks.agentrelay.com"
  },

  // The apex front door. Cloud's prod AgentRelayRouter must have released the
  // agentrelay.com custom domain (cloud#2461 deployed) before this claims it.
  "routes": [
    { "pattern": "agentrelay.com", "custom_domain": true },
    // Short agent-chat front door. Its zone must be in this account with no
    // existing apex/www DNS records before the first deploy attaches these.
    { "pattern": "arelay.to", "custom_domain": true },
    { "pattern": "www.arelay.to", "custom_domain": true },
    // Serves exactly what agentrelay.com serves (src/hosts.ts lists it as a
    // primary-host alias; responses carry X-Robots-Tag: noindex). Its DNS name
    // must have no existing record before the first deploy attaches it.
    { "pattern": "public.agentrelay.com", "custom_domain": true }
  ],

  "workers_dev": false,
  "preview_urls": true,
  "observability": { "enabled": true },

  // Staging: `wrangler deploy --env staging` (deploy-staging.yml, manual only).
  // A separate Worker fronting public-staging.agentrelay.com, falling back to
  // the staging web Worker. Wrangler does not inherit bindings, vars or routes
  // into an environment, so everything staging gets is listed here.
  //
  // Deliberately NOT bound in staging (no staging counterparts exist; the
  // router tolerates every one being absent):
  //   - CLOUD_WEB_WORKER (cloud-web-worker): /cloud* answers 503 unless
  //     CLOUD_PROXY_ORIGIN is set. TODO(staging-cloud): choose the target.
  //   - RELAY_AGENT_WORKER (relay-agent): agent-chat/registry routes are
  //     arelay.to only, and staging does not serve arelay.to.
  //   - ROUTER_CONFIG KV: no webhook flag, recorder or cloud facade in staging.
  //   - TRAFFIC_RECORDER R2: no replay recording in staging.
  //   - ARELAY_ANALYTICS: no guide-fetch analytics in staging.
  "env": {
    "staging": {
      "name": "agentrelay-router-staging",
      "vars": {
        // Required by the router's Env type; only reached for /cloud* when
        // CLOUD_PROXY_ORIGIN is set, which then takes precedence.
        "CLOUD_APP_ORIGIN": "https://origin.agentrelay.cloud",
        "FILE_OBSERVER_ORIGIN": "https://relayfile-file-observer.pages.dev",
        "WEB_ORIGIN": "https://origin-web-staging.agentrelay.com"
        // TODO(staging-cloud): "CLOUD_PROXY_ORIGIN": "<staging cloud origin>"
      },
      "routes": [
        { "pattern": "public-staging.agentrelay.com", "custom_domain": true }
      ]
    }
  }
}
